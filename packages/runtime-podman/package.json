{
  "name": "@loom/runtime-podman",
  "version": "0.1.1",
  "description": "Podman runtime adapter for Devroost service lifecycle and backups.",
  "keywords": [
    "loom",
    "podman",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Devroost-org/devroost.git",
    "directory": "packages/runtime-podman"
  },
  "bugs": {
    "url": "https://github.com/Devroost-org/devroost/issues"
  },
  "homepage": "https://github.com/Devroost-org/devroost#readme",
  "license": "Elastic-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -b tsconfig.json",
    "typecheck": "pnpm exec tsc -b tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "lint": "echo 'No lint rules configured'"
  },
  "dependencies": {
    "@loom/config": "workspace:*"
  }
}
