{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@devroost/stacks": ["./stacks/index.ts"],
      "@devroost/config": ["./packages/config/src/index.ts"],
      "@devroost/runtime-podman": ["./packages/runtime-podman/src/index.ts"],
      "@devroost/core": ["./packages/core/src/index.ts"],
      "@devroost/tasks": ["./packages/tasks/src/index.ts"],
      "@devroost/network": ["./packages/network/src/index.ts"],
      "@devroost/https": ["./packages/https/src/index.ts"]
    },
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  }
}
